# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Environments
.venv/
venv/
.env

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store

# Data and model artifacts fetched at runtime (see scripts/fetch_assets.py).
# laptop_data.csv is the one exception: it is small enough to commit and lets CI
# run a real end-to-end training test without network access.
data/raw/*
!data/raw/.gitkeep
!data/raw/laptop_price/
data/raw/laptop_price/*
!data/raw/laptop_price/laptop_data.csv
!data/raw/series_forecast/
data/raw/series_forecast/*
!data/raw/series_forecast/DailyDelhiClimateTrain.csv
!data/raw/series_forecast/adidas-quarterly-sales.csv
# The article corpus (9.4 MB) and the vision samples (2.7 MB) are small enough
# to commit, which lets CI exercise retrieval and detection end to end.
!data/raw/article_search/
!data/raw/article_search/*.txt
!data/raw/object_detection/
!data/raw/object_detection/*.jpg
!data/raw/object_detection/*.jpeg
!data/raw/object_detection/haarcascade_*.xml
# The Spark projects: 2 MB of adjacency list, names and 768 clinical rows, so
# CI can run a real distributed job end to end rather than a mocked one.
!data/raw/marvel_network/
!data/raw/marvel_network/Marvel-graph.txt
!data/raw/marvel_network/Marvel-names.txt
!data/raw/diabetes_screening/
!data/raw/diabetes_screening/pima-indians-diabetes.csv
# 0.9 MB of USGS earthquakes and US cities: the geospatial project's inputs.
!data/raw/earthquake_atlas/
!data/raw/earthquake_atlas/earthquakes.csv
!data/raw/earthquake_atlas/us-cities.csv
data/interim/
# Trained models are regenerable and large (the loan forest alone is 80 MB), but
# the evidence they produced - metrics, provenance, benchmark tables and
# diagnostic plots - is small and worth reading straight from the repo.
artifacts/**/*.joblib
artifacts/**/*.pkl
*.keras
*.h5
*.pt
*.pth
*.onnx

# Large tabular assets pulled from the Hugging Face Hub
data/external/

# CatBoost writes a training log directory into the working directory
catboost_info/
coverage.xml
